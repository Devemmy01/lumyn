# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Paste only the content value from Search Console's HTML meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
MONGODB_URI=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ACADEMY_SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Firebase web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Academy AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MAX_OUTPUT_TOKENS=8000
# Course generation needs room for modules, lessons, assessments, and projects.
# This is separate from shorter tutor and evaluation responses.
GEMINI_COURSE_MAX_OUTPUT_TOKENS=8000
# Retry transient Gemini failures four times by default. Course generation uses
# the maximum six retries because it is a longer, user-initiated operation.
# Allowed range: 0-6.
GEMINI_TRANSIENT_RETRIES=4
# VIP students get free AI tutor access and free certificates regardless of subscription.
ACADEMY_VIP_EMAILS=

# YouTube Data API enrichment. Leave blank to fall back to YouTube search links.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_DAYS=30

# Flutterwave, Academy subscriptions, and certificate unlocks.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
ACADEMY_SUBSCRIPTION_PRICE_CENTS=900
ACADEMY_CERTIFICATE_PRICE_CENTS=200
ACADEMY_PAYMENT_CURRENCY=USD

# Resend sending and receiving
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lumyn <hello@example.com>
RESEND_WEBHOOK_SECRET=
LUMYN_ADMIN_EMAIL=
