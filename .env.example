# Application
# In production this MUST be the www host: https://www.lumynhq.studio
# lumynhq.studio (apex) redirects to www — every canonical tag, the sitemap,
# OG/JSON-LD urls, and NextAuth callbacks derive from this one value, so
# pointing it at the apex reintroduces the canonical-points-to-a-redirect bug.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Paste only the content value from Search Console's HTML meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
MONGODB_URI=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ACADEMY_SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Firebase web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Academy AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MAX_OUTPUT_TOKENS=8000
# Course generation needs room for modules, lessons, assessments, and projects.
# This is separate from shorter tutor and evaluation responses.
GEMINI_COURSE_MAX_OUTPUT_TOKENS=8000
# Retry transient Gemini failures four times by default. Course generation uses
# the maximum six retries because it is a longer, user-initiated operation.
# Allowed range: 0-6.
GEMINI_TRANSIENT_RETRIES=4
# VIP students get free AI tutor access and free certificates regardless of subscription.
ACADEMY_VIP_EMAILS=

# YouTube Data API enrichment. Leave blank to fall back to YouTube search links.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_DAYS=30

# Flutterwave, Academy subscriptions, and certificate unlocks.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
ACADEMY_SUBSCRIPTION_PRICE_CENTS=900
ACADEMY_CERTIFICATE_PRICE_CENTS=200
ACADEMY_PAYMENT_CURRENCY=USD

# Paystack, marketplace course purchases and the one-time creator listing fee.
PAYSTACK_SECRET_KEY=
MARKETPLACE_PAYMENT_CURRENCY=USD
MARKETPLACE_PLATFORM_SHARE_PERCENT=20
MARKETPLACE_LISTING_FEE_CENTS=
MARKETPLACE_SPLIT_BEARER_TYPE=account

# Bunny Stream, creator-uploaded marketplace course video.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_SIGNED_URL_TTL_SECONDS=21600

# Field-level encryption for sensitive marketplace data at rest (creator bank
# account numbers, government ID numbers). Must be a base64-encoded 32-byte
# key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and durable — rotating it makes previously-encrypted values
# undecryptable.
FIELD_ENCRYPTION_KEY=

# Resend sending and receiving
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lumyn <hello@example.com>
RESEND_WEBHOOK_SECRET=
LUMYN_ADMIN_EMAIL=

# Field guide store (/guides). Reuses PAYSTACK_SECRET_KEY above — no split,
# just a plain charge. Prices/products live in lib/store/products.ts.
# How long a download link stays valid, in days.
STORE_DOWNLOAD_TOKEN_TTL_DAYS=7
# How many times a single download link can be used before it's exhausted.
STORE_DOWNLOAD_CAP=5

# Ad slots (Adsterra only — Monetag's only verification path installs a
# service worker for their push-notification format, which this project's
# ad rules exclude; see lib/ads/config.ts). Never rendered on /guides — see
# lib/ads/no-ads-zone.tsx. Everything here is public (embedded in page HTML),
# so these are NEXT_PUBLIC_, not secrets.
# Global kill switch — set to "false" to disable every ad slot in one deploy.
NEXT_PUBLIC_ADS_ENABLED=true
# Per-placement network slot IDs, from each network's dashboard.
NEXT_PUBLIC_AD_JOURNAL_INLINE_SLOT_ID=
NEXT_PUBLIC_AD_TOOL_BELOW_RESULT_SLOT_ID=
NEXT_PUBLIC_AD_TOOLS_INDEX_SLOT_ID=
# Per-placement kill switches.
NEXT_PUBLIC_AD_JOURNAL_INLINE_ENABLED=true
NEXT_PUBLIC_AD_TOOL_BELOW_RESULT_ENABLED=true
NEXT_PUBLIC_AD_TOOLS_INDEX_ENABLED=true
# One tag template per placement, not per network — a single network can
# serve incompatible tag shapes for different ad formats (e.g. Adsterra's
# Banner units use an atOptions+invoke.js pattern; its Native Banner units
# use a plain script + target <div>, on a different script domain). Each is
# the exact <script>...</script> snippet from that ad unit's "get code" page,
# with {{slotId}}, {{width}}, {{height}} left as literal placeholders for
# lib/ads/networks.ts to substitute. Left blank, that placement renders only
# an empty reserved box — never a broken page.
NEXT_PUBLIC_AD_JOURNAL_INLINE_TAG_TEMPLATE=
NEXT_PUBLIC_AD_TOOL_BELOW_RESULT_TAG_TEMPLATE=
NEXT_PUBLIC_AD_TOOLS_INDEX_TAG_TEMPLATE=
# Comma-separated, exact origins (no wildcards) the ad scripts are actually
# allowed to load from — copy these from the tag snippets above (different
# placements may use different script domains; list them all). Used as the
# sandboxed ad iframe's own CSP; left blank, no ad script executes at all.
NEXT_PUBLIC_AD_SCRIPT_ORIGINS=
