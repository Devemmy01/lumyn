# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Paste only the content value from Search Console's HTML meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
MONGODB_URI=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ACADEMY_SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Firebase web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Academy AI (OPEN_ROUTER_KEY is also supported)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_MAX_TOKENS=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: set to "gemini" or "openrouter" to force one provider.
ACADEMY_AI_PROVIDER=
ACADEMY_COURSE_EXEMPT_EMAILS=

# YouTube Data API enrichment. Leave blank to fall back to YouTube search links.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_DAYS=30

# Flutterwave and Academy points.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
ACADEMY_POINT_PRICE_CENTS=50
ACADEMY_PAYMENT_CURRENCY=USD

# Resend sending and receiving
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lumyn <hello@example.com>
RESEND_WEBHOOK_SECRET=
LUMYN_ADMIN_EMAIL=
