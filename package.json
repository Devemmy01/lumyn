{
  "name": "lumyn",
  "version": "1.0.0",
  "private": true,
  "browserslist": {
    "production": [
      "chrome >= 64",
      "and_chr >= 64",
      "android >= 4.4",
      "edge >= 79",
      "firefox >= 67",
      "opera >= 51",
      "safari >= 12",
      "ios_saf >= 12"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "dev:turbo": "NEXT_DIST_DIR=.next-turbo next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "ts-node --project tsconfig.seed.json scripts/seed.ts",
    "generate:catalog": "ts-node --project tsconfig.seed.json scripts/generate_academy_catalog.ts",
    "draft:seo": "ts-node --project tsconfig.seed.json scripts/generate_seo_drafts.ts",
    "publish:seo": "ts-node --project tsconfig.seed.json scripts/publish_seo_drafts.ts"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-highlight": "^3.22.0",
    "@tiptap/extension-image": "^3.22.0",
    "@tiptap/extension-link": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/extension-subscript": "^3.22.0",
    "@tiptap/extension-superscript": "^3.22.0",
    "@tiptap/extension-text-align": "^3.22.0",
    "@tiptap/extension-underline": "^3.22.0",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "framer-motion": "^12.36.0",
    "gray-matter": "^4.0.3",
    "jose": "^4.15.9",
    "mongodb": "^6.12.0",
    "mongoose": "^8.24.2",
    "next": "^15.5.22",
    "next-auth": "^4.24.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.0"
  }
}
